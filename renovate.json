{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "JDK images in the CircleCI build matrix use major.minor tags: allow minor updates only, majors are added manually",
      "matchPackageNames": ["cimg/openjdk"],
      "matchUpdateTypes": ["major", "patch"],
      "enabled": false
    }
  ]
}
